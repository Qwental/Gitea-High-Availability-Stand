groups:
  - name: infrastructure_alerts
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ .Labels.instance }}{% endraw %}"
          description: "Сервер {% raw %}{{ .Labels.instance }}{% endraw %} (job: {% raw %}{{ .Labels.job }}{% endraw %}) недоступен более 1 минуты."

      - alert: HostOutOfDiskSpace
        expr: (node_filesystem_avail_bytes{mountpoint="/"}  * 100) / node_filesystem_size_bytes{mountpoint="/"} < 5
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "Заканчивается место на {% raw %}{{ .Labels.instance }}{% endraw %}"
          description: "На сервере {% raw %}{{ .Labels.instance }}{% endraw %} осталось менее 5% свободного места на корневом разделе."