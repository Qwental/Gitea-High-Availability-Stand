global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: 'szopinskiflight@gmail.com'
  smtp_auth_username: 'szopinskiflight@gmail.com'
  smtp_auth_password: '{{ vault_alertmanager_email_password }}'
  smtp_require_tls: tru

route:
  group_by: ['alertname']
  group_wait: 10s
  group_interval: 10s
  repeat_interval: 1h
  receiver: 'email-admin'

receivers:
  - name: 'email-admin'
    email_configs:
      - to: '{{ email_for_alerts }}'
