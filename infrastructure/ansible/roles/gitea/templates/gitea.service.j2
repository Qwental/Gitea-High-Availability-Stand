[Unit]
Description=Gitea
After=syslog.target
After=network.target
After=postgresql.service
RequiresMountsFor=/var/lib/gitea/data/gitea-repositories

[Service]
RestartSec=2s
Type=simple
User={{ gitea_user }}
Group={{ gitea_group }}
WorkingDirectory={{ gitea_work_dir }}
ExecStart=/usr/local/bin/gitea web --config {{ gitea_conf_dir }}/app.ini
Restart=always
Environment=USER={{ gitea_user }} HOME={{ gitea_home }} GITEA_WORK_DIR={{ gitea_work_dir }}

[Install]
WantedBy=multi-user.target