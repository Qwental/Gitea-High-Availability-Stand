defaults
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h

listen nfs
    bind *:2049
    default-server on-marked-down shutdown-sessions
    server storage-01 172.20.0.41:2049 check
    server storage-02 172.20.0.42:2049 check backup

listen mountd
    bind *:20048
    default-server on-marked-down shutdown-sessions
    server storage-01 172.20.0.41:20048 check
    server storage-02 172.20.0.42:20048 check backup

listen rpcbind
    bind *:111
    server storage-01 172.20.0.41:111
    server storage-02 172.20.0.42:111 backup
