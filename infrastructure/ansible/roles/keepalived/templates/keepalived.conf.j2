global_defs {
    enable_script_security
    script_user root
}

vrrp_script check_pg {
    script "/usr/bin/pg_isready -U postgres" 
    interval 2
    weight -20
    fall 2
    rise 2
    user postgres
}

vrrp_instance VI_1 {
    state {{ 'MASTER' if inventory_hostname == 'db-01' else 'BACKUP' }}
    interface eth0
    virtual_router_id 51
    priority {{ keepalived_priority }}
    advert_int 1

    unicast_src_ip {{ hostvars[inventory_hostname]['ansible_host_ip'] | default(ansible_eth0.ipv4.address) }}
    unicast_peer {
        {% for host in groups['db_cluster'] %}
        {% if host != inventory_hostname %}
        {{ hostvars[host]['ansible_host_ip'] | default(hostvars[host]['ansible_eth0']['ipv4']['address']) }}
        {% endif %}
        {% endfor %}
    }

    authentication {
        auth_type PASS
        auth_pass amikon8
    }
    virtual_ipaddress {
        {{ pg_vip }}/{{ pg_netmask }}
    }
    track_script {
        check_pg
    }
}